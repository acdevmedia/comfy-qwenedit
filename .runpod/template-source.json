{
  "templateId": "r1fg429s5w",
  "templateName": "Qwen Image Edit 2511 ComfyUI One-Click",
  "imageName": "ghcr.io/acdevmedia/qwenedit-comfyui:2511",
  "containerDiskInGb": 200,
  "volumeMountPath": "/workspace",
  "ports": [
    "8188/http"
  ],
  "env": {
    "HF_HOME": "/workspace/.cache/huggingface",
    "MODEL_MODE": "lightning",
    "STUDIO_VERSION": "2511",
    "PORT": "8000",
    "PORT_HEALTH": "8001"
  },
  "isPublic": true,
  "startJupyter": false,
  "startSsh": false,
  "dockerEntrypoint": null,
  "dockerStartCmd": null,
  "volumeInGb": 0
}
